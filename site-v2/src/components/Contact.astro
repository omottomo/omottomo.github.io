---
import { site, hasResume } from '../data/site';
import { certifications, education } from '../data/certifications';

const mailtoHref = `mailto:${site.email}?subject=${encodeURIComponent('포트폴리오 문의')}`;
---

<section id="contact" class="scroll-mt-24 border-t border-line pb-24 pt-16">
  <h2 class="font-mono text-[15px] uppercase tracking-[0.14em] text-faint">Contact</h2>

  <p
    class="mt-5 max-w-[26em] text-[clamp(22px,3vw,28px)] font-semibold leading-[1.4] tracking-[-0.02em] break-keep"
  >
    새로운 기회와 협업 제안에 언제나 열려 있습니다 편하게 연락 주세요.
  </p>

  <div class="mt-7.5 flex flex-wrap gap-2.5">
    <a
      href={mailtoHref}
      class="rounded-[10px] bg-text px-5 py-3.5 text-[15px] font-semibold text-bg transition-colors hover:bg-accent hover:text-bg"
    >
      {site.email}
    </a>
    {hasResume && (
      <a
        href={site.resumeUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-[10px] border border-text px-5 py-3.5 text-[15px] font-semibold transition-colors hover:bg-text hover:text-bg"
      >
        이력서 PDF ↓
      </a>
    )}
    <a
      href={site.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="rounded-[10px] border border-line-strong px-5 py-3.5 text-[15px] font-semibold transition-colors hover:border-text"
    >
      GitHub ↗
    </a>
  </div>

  <div class="mt-12 grid gap-x-10 gap-y-7 sm:grid-cols-2">
    <div id="certifications" class="scroll-mt-24">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.1em] text-faint">
        Certifications
      </p>
      {certifications.map((c) => (
        <p class="mt-3.5 text-[15px] leading-[1.6] first:mt-0">
          <span class="font-semibold">{c.name}</span><br />
          <span class="font-mono text-[13px] text-faint">{c.issuer} · {c.date}</span>
        </p>
      ))}
    </div>

    <div id="education" class="scroll-mt-24">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.1em] text-faint">Education</p>
      {education.map((e) => (
        <p class="mt-3.5 text-[15px] leading-[1.6] first:mt-0">
          <span class="font-semibold">{e.school}</span>
          {[e.major, e.degree].filter(Boolean).join(' ')}<br />
          {e.period && <span class="font-mono text-[13px] text-faint">{e.period}</span>}
        </p>
      ))}
    </div>
  </div>
</section>
