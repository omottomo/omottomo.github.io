---
// 카테고리별 한 줄 요약 — 배지 클러스터를 줄이고 "무엇을 어디까지" 만 남겼다.
const groups = [
  { category: 'CI/CD', items: 'Jenkins · Quickbuild', note: '파이프라인 오케스트레이션 · 야간 무인 빌드 · 분산 빌드 구성' },
  { category: 'Language', items: 'Shell · Node.js · Java', note: '자동화 스크립트 · 릴레이 서버(Express·Redis) · Spring 백엔드' },
  { category: 'Cloud', items: 'AWS · Naver Cloud', note: 'SAA · NCP Professional 자격 보유 · 인프라 구성·운영' },
  { category: 'Quality', items: 'Coverity · gcov·lcov', note: '정적분석 품질 게이트 · Code Coverage 측정·리포트 연동' },
  { category: 'OS · Infra', items: 'Linux', note: '서버 구성·운영 · init 스크립트 표준화 · 정기 보안 점검 조치' },
  { category: 'SCM · Ops', items: 'Git · GitHub Actions', note: '형상관리·협업 · 이 사이트 CI/CD 배포' },
];
---

<section id="skills" class="scroll-mt-24 border-t border-line py-16">
  <h2 class="font-mono text-[15px] uppercase tracking-[0.14em] text-faint">Skills</h2>

  <div class="mt-6 grid gap-x-10 gap-y-7 sm:grid-cols-2 lg:grid-cols-3">
    {groups.map((g) => (
      <div>
        <p class="mb-2.5 text-[13px] font-bold tracking-[0.04em]">{g.category}</p>
        <p class="text-[15px] leading-[1.7] text-text-soft">{g.items}</p>
        <p class="mt-1 text-[13.5px] text-faint break-keep">{g.note}</p>
      </div>
    ))}
  </div>
</section>
