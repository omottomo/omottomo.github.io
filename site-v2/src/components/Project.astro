---
import { site } from '../data/site';
import { personalProjects } from '../data/personal';

// 개인 프로젝트가 비어 있으면 자리표시 슬롯 2개를 보여준다.
const slots = [1, 2];
---

<section id="project" class="scroll-mt-24 border-t border-line py-16">
  <div class="flex flex-wrap items-baseline justify-between gap-5">
    <h2 class="font-mono text-[15px] uppercase tracking-[0.14em] text-faint">Project</h2>
    <a
      href={site.githubUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="text-[13.5px] text-accent"
    >
      github.com/{site.githubHandle} ↗
    </a>
  </div>

  <div class="mt-6 grid gap-4 sm:grid-cols-2">
    {
      personalProjects.length > 0
        ? personalProjects.map((p) => (
            <article class="rounded-xl border border-line bg-surface p-6">
              <h3 class="text-[16.5px] font-semibold tracking-[-0.01em]">{p.title}</h3>
              <p class="mt-2 text-[14.5px] leading-[1.6] text-muted break-keep">{p.oneLine}</p>
              <ul class="mt-4 flex flex-wrap gap-1.5">
                {p.tech.map((t) => (
                  <li
                    class="rounded-md border border-line-soft bg-surface-2 px-2.5 py-1 font-mono text-xs text-muted"
                  >
                    {t}
                  </li>
                ))}
              </ul>
              {p.href && (
                <a
                  href={p.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-4 inline-block font-mono text-[13px] text-accent"
                >
                  저장소 ↗
                </a>
              )}
            </article>
          ))
        : slots.map((n) => (
            <div
              class="flex min-h-[150px] flex-col justify-between rounded-xl border border-dashed border-line-dash bg-slot px-5.5 py-6.5"
            >
              <p class="font-mono text-xs uppercase tracking-[0.1em] text-dim">
                Slot {String(n).padStart(2, '0')}
              </p>
              <p class="font-mono text-[13px] leading-[1.6] text-faint">
                개인 프로젝트 이름 / 한 줄 설명 / 사용 기술 / 저장소 링크
              </p>
            </div>
          ))
    }
  </div>
</section>
