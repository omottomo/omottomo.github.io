---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = '이동욱 — DevOps 엔지니어',
  description =
    'CI/CD 파이프라인을 무인 자동화해 빌드·테스트 시간을 줄이는 DevOps 엔지니어 이동욱의 포트폴리오.',
  image = '/og-image.png',
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const ogImageURL = Astro.site ? new URL(image, Astro.site) : undefined;

const nav = [
  { href: '#summary', label: 'Summary' },
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '#project', label: 'Project' },
  { href: '#contact', label: 'Contact' },
];

const year = 2026;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {canonicalURL && <link rel="canonical" href={canonicalURL.href} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="ko_KR" />
    {canonicalURL && <meta property="og:url" content={canonicalURL.href} />}
    {ogImageURL && <meta property="og:image" content={ogImageURL.href} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL.href} />}

    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable.min.css"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Libre+Franklin:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body class="min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:bg-text focus:px-4 focus:py-2 focus:font-mono focus:text-sm focus:text-bg"
    >
      본문으로 건너뛰기
    </a>

    <header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
      <nav
        id="site-nav"
        class="mx-auto flex h-16 max-w-[900px] items-center justify-end gap-6 px-7"
        aria-label="주요 내비게이션"
      >
        <div id="nav-links" class="flex items-center gap-[22px]">
          {nav.map((item) => (
            <a href={item.href} class="text-[13.5px] text-muted transition-colors">
              {item.label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main id="main" class="mx-auto max-w-[900px] px-7">
      <slot />
    </main>

    <footer class="border-t border-line">
      <div
        class="mx-auto flex max-w-[900px] flex-wrap justify-between gap-3 px-7 py-7 font-mono text-xs text-faint"
      >
        <span>{site.name} · DevOps Engineer</span>
        <span>© {year}</span>
      </div>
    </footer>
  </body>
</html>
